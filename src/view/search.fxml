<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.SearchController">
    <HBox spacing="10">
        <Label text="Start Date:"/>
        <DatePicker fx:id="startDatePicker"/>
        <Label text="End Date:"/>
        <DatePicker fx:id="endDatePicker"/>
    </HBox>
    <HBox spacing="10">
        <Label text="Tag Key:"/>
        <TextField fx:id="tagKeyField" promptText="e.g., location"/>
        <Label text="Tag Value:"/>
        <TextField fx:id="tagValueField" promptText="e.g., New York"/>
    </HBox>
    <HBox spacing="10">
        <Label text="Operator:"/>
        <ComboBox fx:id="operatorComboBox" promptText="AND/OR"/>
        <Label text="Tag Key 2:"/>
        <TextField fx:id="tagKeyField2" promptText="e.g., person"/>
        <Label text="Tag Value 2:"/>
        <TextField fx:id="tagValueField2" promptText="e.g., sesh"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Search by Date" onAction="#handleSearchByDate"/>
        <Button text="Search by Tag" onAction="#handleSearchByTag"/>
    </HBox>
    <ListView fx:id="resultListView" prefHeight="200" prefWidth="300"/>
    <Button text="Create Album from Results" onAction="#handleCreateAlbumFromResults"/>
    <Button text="Back" onAction="#handleBack"/>
</VBox>